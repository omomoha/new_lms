# Firebase Web SDK — public keys (safe to commit, .env is gitignored)
# Copy this file to .env.local and fill in your Firebase project values.

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id-here

# Optional: Firebase emulator host override (for local dev)
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# ── Phase 3: App Check (optional until you enable enforcement) ──────────────
# Firebase console → App Check → register web app with reCAPTCHA v3.
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-v3-site-key
# Local dev only: prints a debug token in the browser console to allow-list.
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=true
