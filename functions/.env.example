# Slack Incoming Webhook URL
# Create one at https://api.slack.com/messaging/webhooks
# (Slack App → Incoming Webhooks → Activate → Add New Webhook to Workspace)
# Copy the generated URL (starts with https://hooks.slack.com/services/...) here.
# Leave blank to disable Slack notifications — the functions will log a warning
# but will NOT fail if this variable is missing.
SLACK_WEBHOOK_URL=

# Phase 3: used in certificate verify links + emails
PUBLIC_APP_URL=https://andela-lms-dae5f.web.app

# Phase 3: App Check enforcement for callable functions.
# Leave false until App Check is registered + monitored in the console.
ENFORCE_APPCHECK=false
