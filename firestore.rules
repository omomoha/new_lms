rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Andela LMS — Firestore Security Rules
//
// Role is stored as a custom claim: request.auth.token.role
//   "admin"   → full read/write on course/cohort/user data
//   "learner" → read courses assigned to their cohorts; write own progress
//
// The custom claim is set by the bulkOnboard Cloud Function via
// admin.auth().setCustomUserClaims(uid, { role }). Clients must call
// user.getIdToken(true) to force-refresh the token after onboarding.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // Is the caller authenticated at all?
    function isAuthed() {
      return request.auth != null;
    }

    // Does the caller have the admin custom claim?
    function isAdmin() {
      return isAuthed() && request.auth.token.role == "admin";
    }

    // Any authenticated NON-admin is a learner. Deliberately claim-optional:
    // accounts created before the syncRoleClaim trigger existed carry no role
    // claim at all, and learner is the lowest-privilege default anyway.
    function isLearner() {
      // token.get() is REQUIRED here: accounts created before the claim-sync
      // trigger have NO role key, and `token.role != "admin"` on a missing key
      // throws inside rules — which evaluates as deny. get() with a default
      // makes claimless users learners (lowest privilege) safely.
      return isAuthed() && request.auth.token.get("role", "learner") != "admin";
    }

    // Is the caller operating on their own data?
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ── users/{uid} ─────────────────────────────────────────────────────────
    match /users/{uid} {
      // Users can read their own doc; admins can read any user doc
      allow read: if isOwner(uid) || isAdmin();
      // Self-signup: a user may CREATE only their OWN doc and only as a learner
      // (prevents self-promotion to admin). Profile updates remain admin-only.
      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.role == "learner");
      allow update, delete: if isAdmin();
    }

    // ── cohorts/{id} ────────────────────────────────────────────────────────
    // Fix #15: restrict cohort reads — admins or a learner who is a member
    // (cohort id must appear in the caller's users/{uid}.cohortIds).
    // Removed the previous blanket isAuthed() read.
    match /cohorts/{cohortId} {
      allow read: if isAdmin()
        || (isLearner()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortIds.hasAny([cohortId])
           );
      allow write: if isAdmin();
    }

    // ── courses/{id} ────────────────────────────────────────────────────────
    match /courses/{courseId} {
      // Admins have full access.
      // Learners can read ANY published course doc (cohort gate lives on
      // modules/lessons subcollections so unassigned learners see the course
      // title/description but cannot access content).
      allow read: if isAdmin()
        || (isLearner() && resource.data.status == "published");
      allow write: if isAdmin();

      // Fix #14: modules subcollection — enforce same cohort-assignment check
      // as the course-level rule (not just published status).
      match /modules/{moduleId} {
        allow read: if isAdmin()
          || (isLearner()
              && get(/databases/$(database)/documents/courses/$(courseId)).data.status == "published"
              && get(/databases/$(database)/documents/courses/$(courseId)).data.assignedCohortIds.hasAny(
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortIds
                 )
             );
        allow write: if isAdmin();

        // Fix #14: lessons subcollection — enforce same cohort-assignment check
        // as the course-level rule (not just published status).
        match /lessons/{lessonId} {
          allow read: if isAdmin()
            || (isLearner()
                && get(/databases/$(database)/documents/courses/$(courseId)).data.status == "published"
                && get(/databases/$(database)/documents/courses/$(courseId)).data.assignedCohortIds.hasAny(
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortIds
                   )
               );
          allow write: if isAdmin();
        }
      }
    }

    // ── enrollments/{uid_courseId} ──────────────────────────────────────────
    // Fix #16: learner may only write their own enrollment AND only for a course
    // assigned to one of their cohorts (verified via get() on the course doc).
    // enrollmentId format: "{userId}_{courseId}"
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (isAuthed() && enrollmentId.matches(request.auth.uid + "_.*"));

      // Fix #16: write requires own doc AND cohort assignment check.
      // courseId is everything after "{uid}_" — split on the literal uid prefix
      // (NOT on "_") so a courseId that itself contains underscores cannot be
      // used to point the cohort check at a different course doc.
      allow write: if isAdmin()
        || (isAuthed()
            && enrollmentId.matches(request.auth.uid + "_.+")
            && get(/databases/$(database)/documents/courses/$(enrollmentId.split(request.auth.uid + "_")[1])).data.assignedCohortIds.hasAny(
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortIds
               )
           );
    }

    // ── certificateLocks/{uid_courseId} ─────────────────────────────────────
    // Issuance concurrency locks — written ONLY by the certificate Cloud
    // Functions via the admin SDK. No client access.
    match /certificateLocks/{lockId} {
      allow read, write: if false; // admin SDK only
    }

    // ── progress/{uid_lessonId} ─────────────────────────────────────────────
    match /progress/{progressId} {
      // Learner can read/write their own progress docs.
      // progressId format: "{userId}_{lessonId}"
      allow read: if isAdmin()
        || (isAuthed() && progressId.matches(request.auth.uid + "_.*"));
      allow write: if isAdmin()
        || (isAuthed() && progressId.matches(request.auth.uid + "_.*"));
    }

    // ── mail/{id} ───────────────────────────────────────────────────────────
    // Written by Cloud Functions (admin SDK bypasses rules).
    // No client reads allowed — email content is sensitive.
    match /mail/{id} {
      allow read, write: if false; // admin SDK only
    }

    // ── assessments/{id} ────────────────────────────────────────────────────
    // Questions are readable by admins or learners whose cohort is assigned to
    // the course. All queries must include a courseId equality filter so this
    // get()-based rule is provable by Firestore.
    match /assessments/{assessmentId} {
      allow read: if isAdmin()
        || (isLearner()
            && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.assignedCohortIds.hasAny(
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortIds
               ));
      allow write: if isAdmin();
    }

    // ── assessmentKeys/{assessmentId} ───────────────────────────────────────
    // Stores { answers: { [questionId]: correctOptionIndex } }.
    // Admins may read (so the editor can prefill correct answers) and write.
    // Learners never have access. Cloud Functions use the admin SDK which
    // bypasses these rules entirely.
    match /assessmentKeys/{assessmentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── attempts/{attemptId} ────────────────────────────────────────────────
    // Written ONLY by the gradeAttempt Cloud Function via admin SDK.
    // attemptId format: "{uid}_{assessmentId}_{uuid}"
    //
    // FIX: the previous doc-ID prefix rule (attemptId.matches(uid + "_.*"))
    // is NOT provable for list queries filtered by fields, so every learner
    // query for their own attempts was denied (surfaced as "Missing or
    // insufficient permissions" on any course with assessments). Owner check
    // now uses resource.data.userId — provable for queries that filter
    // userId == request.auth.uid (which all client queries do), and valid
    // for single-doc gets. userId is always set by gradeAttempt.
    match /attempts/{attemptId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false; // gradeAttempt function only via admin SDK
    }

    // ── certificates/{certId} ───────────────────────────────────────────────
    // Phase 3. Written ONLY by the certificate Cloud Functions via admin SDK.
    // Single-doc GET is PUBLIC — the /verify/[certId] page works without
    // sign-in (a certificate is a deliberately shareable artifact).
    // LIST queries are restricted: admins see all; a learner may only list
    // their own (queries must filter userId == their uid to be provable).
    match /certificates/{certId} {
      allow get: if true;
      allow list: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false; // certificate functions only via admin SDK
    }

    // ── settings/{id} ───────────────────────────────────────────────────────
    // Phase 3. Global app settings (e.g. settings/certificate holds the
    // default certificate template). Admin-managed; functions read via
    // admin SDK.
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
