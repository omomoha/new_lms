rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Andela LMS — Firestore Security Rules
//
// Role is stored as a custom claim: request.auth.token.role
//   "admin"   → full read/write on course/cohort/user data
//   "learner" → read courses assigned to their cohorts; write own progress
//
// The custom claim is set by the bulkOnboard Cloud Function via
// admin.auth().setCustomUserClaims(uid, { role }). Clients must call
// user.getIdToken(true) to force-refresh the token after onboarding.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // Is the caller authenticated at all?
    function isAuthed() {
      return request.auth != null;
    }

    // Does the caller have the admin custom claim?
    function isAdmin() {
      return isAuthed() && request.auth.token.role == "admin";
    }

    // Any authenticated NON-admin is a learner. Deliberately claim-optional:
    // accounts created before the syncRoleClaim trigger existed carry no role
    // claim at all, and learner is the lowest-privilege default anyway.
    function isLearner() {
      // token.get() is REQUIRED here: accounts created before the claim-sync
      // trigger have NO role key, and `token.role != "admin"` on a missing key
      // throws inside rules — which evaluates as deny. get() with a default
      // makes claimless users learners (lowest privilege) safely.
      return isAuthed() && request.auth.token.get("role", "learner") != "admin";
    }

    // Is the caller operating on their own data?
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // Course availability gate: a published course is accessible when the
    // admin opened it to ALL users (availability == "all") OR it is assigned
    // to one of the caller's cohorts. get() results are cached per request,
    // so the repeated course/user reads cost one document read each.
    function canAccessCourse(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data.status == "published"
        && (
          get(/databases/$(database)/documents/courses/$(courseId)).data.get("availability", "cohorts") == "all"
          || get(/databases/$(database)/documents/courses/$(courseId)).data.assignedCohortIds.hasAny(
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortIds
             )
        );
    }

    // ── users/{uid} ─────────────────────────────────────────────────────────
    match /users/{uid} {
      // Users can read their own doc; admins can read any user doc
      allow read: if isOwner(uid) || isAdmin();
      // Self-signup: a user may CREATE only their OWN doc and only as a learner
      // (prevents self-promotion to admin). Profile updates remain admin-only.
      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.role == "learner");
      // Self-service: a user may update ONLY their own display name.
      // Everything else (role, cohortIds, status, …) stays admin-only.
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 100);
      allow delete: if isAdmin();

      // ── users/{uid}/tutorConversations/{id} ──────────────────────────────
      // Phase 4 (Workstream A). AI-tutor chat threads. Learner-private: the
      // owner reads their own; admins read all for quality review. WRITES are
      // server-side only (the askTutor callable persists turns via the admin
      // SDK) so transcripts can't be forged from the client.
      match /tutorConversations/{conversationId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false; // askTutor function only via admin SDK
      }
    }

    // ── cohorts/{id} ────────────────────────────────────────────────────────
    // Fix #15: restrict cohort reads — admins or a learner who is a member
    // (cohort id must appear in the caller's users/{uid}.cohortIds).
    // Removed the previous blanket isAuthed() read.
    match /cohorts/{cohortId} {
      allow read: if isAdmin()
        || (isLearner()
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cohortIds.hasAny([cohortId])
           );
      allow write: if isAdmin();
    }

    // ── courses/{id} ────────────────────────────────────────────────────────
    match /courses/{courseId} {
      // Admins have full access.
      // Learners can read ANY published course doc (cohort gate lives on
      // modules/lessons subcollections so unassigned learners see the course
      // title/description but cannot access content).
      allow read: if isAdmin()
        || (isLearner() && resource.data.status == "published");
      allow write: if isAdmin();

      // Fix #14: modules subcollection — enforce same cohort-assignment check
      // as the course-level rule (not just published status).
      match /modules/{moduleId} {
        allow read: if isAdmin() || (isLearner() && canAccessCourse(courseId));
        allow write: if isAdmin();

        // Fix #14: lessons subcollection — enforce same cohort-assignment check
        // as the course-level rule (not just published status).
        // Phase 4 (Workstream C): the Mux fields (muxUploadId/muxAssetId/
        // muxPlaybackId/muxStatus, and the "mux:" videoPath rewrite) are written
        // ONLY by the muxWebhook / backfillVideosToMux functions via the admin
        // SDK (which bypasses rules) or by an admin in the builder — clients can
        // never forge them, since lesson writes stay admin-only here.
        match /lessons/{lessonId} {
          allow read: if isAdmin() || (isLearner() && canAccessCourse(courseId));
          allow write: if isAdmin();
        }
      }
    }

    // ── enrollments/{uid_courseId} ──────────────────────────────────────────
    // Fix #16: learner may only write their own enrollment AND only for a course
    // assigned to one of their cohorts (verified via get() on the course doc).
    // enrollmentId format: "{userId}_{courseId}"
    match /enrollments/{enrollmentId} {
      // Read accepts EITHER form (same pattern as progress): the doc-ID
      // prefix covers single gets including not-yet-created enrollments;
      // the field branch makes userId == uid LIST queries provable so the
      // dashboard can load all enrollments in ONE query instead of one
      // get per course (page-load perf).
      allow read: if isAdmin()
        || (isAuthed()
            && (enrollmentId.matches(request.auth.uid + "_.*")
                || resource.data.userId == request.auth.uid));

      // Fix #16: write requires own doc AND cohort assignment check.
      // courseId is everything after "{uid}_" — split on the literal uid prefix
      // (NOT on "_") so a courseId that itself contains underscores cannot be
      // used to point the cohort check at a different course doc.
      allow write: if isAdmin()
        || (isAuthed()
            && enrollmentId.matches(request.auth.uid + "_.+")
            && canAccessCourse(enrollmentId.split(request.auth.uid + "_")[1])
           );
    }

    // ── certificateLocks/{uid_courseId} ─────────────────────────────────────
    // Issuance concurrency locks — written ONLY by the certificate Cloud
    // Functions via the admin SDK. No client access.
    match /certificateLocks/{lockId} {
      allow read, write: if false; // admin SDK only
    }

    // ── progress/{uid_lessonId} ─────────────────────────────────────────────
    match /progress/{progressId} {
      // Learner can read/write their own progress docs.
      // progressId format: "{userId}_{lessonId}"
      // READ allows EITHER form:
      //  - doc-ID prefix: single gets, including docs that don't exist yet
      //    (the lesson page gets progress/{uid}_{lessonId} before first write —
      //    a field-only rule throws on resource == null and denies those)
      //  - field-based (resource.data.userId): makes list queries filtered by
      //    userId == request.auth.uid provable (needed by the streak card)
      allow read: if isAdmin()
        || (isAuthed()
            && (progressId.matches(request.auth.uid + "_.*")
                || resource.data.userId == request.auth.uid));
      allow write: if isAdmin()
        || (isAuthed()
            && progressId.matches(request.auth.uid + "_.*")
            && request.resource.data.userId == request.auth.uid);
    }

    // ── lessonFeedback/{uid_lessonId} ───────────────────────────────────────
    // "Was this lesson helpful?" ratings. Learner writes their own doc;
    // admins can read everything for content analytics.
    match /lessonFeedback/{feedbackId} {
      // ID-prefix branch covers gets of not-yet-written docs (prefill check).
      allow read: if isAdmin()
        || (isAuthed()
            && (feedbackId.matches(request.auth.uid + "_.+")
                || resource.data.userId == request.auth.uid));
      allow write: if isAuthed()
        && feedbackId.matches(request.auth.uid + "_.+")
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
    }

    // ── tutorFeedback/{uid_conversationId_turnIndex} ────────────────────────
    // Phase 4 (Workstream A). Thumbs up/down (+ optional reason) on a tutor
    // answer. The learner creates/overwrites their OWN feedback; admins read
    // everything for quality analytics. Doc-ID prefix must be the caller's uid.
    match /tutorFeedback/{feedbackId} {
      allow read: if isAdmin()
        || (isAuthed()
            && (feedbackId.matches(request.auth.uid + "_.+")
                || resource.data.userId == request.auth.uid));
      allow write: if isAuthed()
        && feedbackId.matches(request.auth.uid + "_.+")
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating in ["up", "down"]
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000;
    }

    // ── labGrades/{uid_lessonId} ────────────────────────────────────────────
    // AI lab grades — written ONLY by the gradeLab function (admin SDK), so
    // learners cannot forge scores. Learner reads their own; admins all.
    match /labGrades/{gradeId} {
      // ID-prefix branch covers gets of not-yet-graded submissions.
      allow read: if isAdmin()
        || (isAuthed()
            && (gradeId.matches(request.auth.uid + "_.+")
                || resource.data.userId == request.auth.uid));
      allow write: if false; // gradeLab function only
    }

    // ── flashcards/{cardId} ─────────────────────────────────────────────────
    // Spaced-repetition cards. Created/deleted ONLY by the generateFlashcards
    // function (admin SDK). The owner may read them and update ONLY the
    // scheduling fields (interval/ease/reps/due) during review — card content
    // and ownership are immutable from the client.
    match /flashcards/{cardId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow update: if isAuthed()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["interval", "ease", "reps", "due"]);
      allow create, delete: if false; // generateFlashcards function only
    }

    // ── aiUsage/{uid} ───────────────────────────────────────────────────────
    // Per-user AI rate-limit buckets — server-side only.
    match /aiUsage/{uid} {
      allow read, write: if false; // admin SDK only
    }

    // ── auditLogs/{id} ──────────────────────────────────────────────────────
    // Admin action trail. Append-only: admins may create entries attributed
    // to THEMSELVES; nothing can ever be updated or deleted from the client.
    // Cloud Functions (bulkOnboard) append via the admin SDK.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 100
        && request.resource.data.targetType is string
        && request.resource.data.targetType.size() <= 50
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000;
      allow update, delete: if false; // append-only
    }

    // ── notifications/{id} ──────────────────────────────────────────────────
    // Created ONLY by Cloud Functions (certificates, reminders). The owner
    // may read their own and mark them read — nothing else.
    match /notifications/{noteId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow update: if isAuthed()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow create, delete: if false; // server-side only
    }

    // ── discussions/{id} ────────────────────────────────────────────────────
    // Per-lesson Q&A. Create-only from clients (no edits); author or admin
    // may delete. Reads/creates are gated on course access — same cohort
    // check as assessments (queries must filter by lessonId/courseId so the
    // get()-based rule stays provable per-document).
    match /discussions/{postId} {
      allow read: if isAdmin()
        || (isLearner()
            && canAccessCourse(resource.data.courseId));
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 100
        && (request.resource.data.parentId == null
            || request.resource.data.parentId is string)
        && (isAdmin()
            || canAccessCourse(request.resource.data.courseId));
      allow delete: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow update: if false; // no edits — delete and repost
    }

    // ── mail/{id} ───────────────────────────────────────────────────────────
    // Written by Cloud Functions (admin SDK bypasses rules).
    // No client reads allowed — email content is sensitive.
    match /mail/{id} {
      allow read, write: if false; // admin SDK only
    }

    // ── assessments/{id} ────────────────────────────────────────────────────
    // Questions are readable by admins or learners whose cohort is assigned to
    // the course. All queries must include a courseId equality filter so this
    // get()-based rule is provable by Firestore.
    match /assessments/{assessmentId} {
      allow read: if isAdmin()
        || (isLearner()
            && canAccessCourse(resource.data.courseId));
      allow write: if isAdmin();
    }

    // ── assessmentKeys/{assessmentId} ───────────────────────────────────────
    // Stores { answers: { [questionId]: correctOptionIndex } }.
    // Admins may read (so the editor can prefill correct answers) and write.
    // Learners never have access. Cloud Functions use the admin SDK which
    // bypasses these rules entirely.
    match /assessmentKeys/{assessmentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── attempts/{attemptId} ────────────────────────────────────────────────
    // Written ONLY by the gradeAttempt Cloud Function via admin SDK.
    // attemptId format: "{uid}_{assessmentId}_{uuid}"
    //
    // FIX: the previous doc-ID prefix rule (attemptId.matches(uid + "_.*"))
    // is NOT provable for list queries filtered by fields, so every learner
    // query for their own attempts was denied (surfaced as "Missing or
    // insufficient permissions" on any course with assessments). Owner check
    // now uses resource.data.userId — provable for queries that filter
    // userId == request.auth.uid (which all client queries do), and valid
    // for single-doc gets. userId is always set by gradeAttempt.
    match /attempts/{attemptId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false; // gradeAttempt function only via admin SDK
    }

    // ── certificates/{certId} ───────────────────────────────────────────────
    // Phase 3. Written ONLY by the certificate Cloud Functions via admin SDK.
    // Single-doc GET is PUBLIC — the /verify/[certId] page works without
    // sign-in (a certificate is a deliberately shareable artifact).
    // LIST queries are restricted: admins see all; a learner may only list
    // their own (queries must filter userId == their uid to be provable).
    match /certificates/{certId} {
      allow get: if true;
      allow list: if isAdmin()
        || (isAuthed() && resource.data.userId == request.auth.uid);
      allow write: if false; // certificate functions only via admin SDK
    }

    // ── settings/{id} ───────────────────────────────────────────────────────
    // Phase 3. Global app settings (e.g. settings/certificate holds the
    // default certificate template). Admin-managed; functions read via
    // admin SDK.
    //
    // EXCEPTION: settings/features (the feature-flag doc) is READABLE by any
    // authenticated user — the client gates UI on it. Writes stay admin-only.
    match /settings/{settingId} {
      allow read: if isAdmin()
        || (settingId == "features" && isAuthed());
      allow write: if isAdmin();
    }

    // ── analytics/{id} (Phase 4 — Workstream D) ─────────────────────────────
    // Pre-aggregated leadership metrics (analytics/overview,
    // analytics/course_{id}, analytics/cohort_{id}). Written ONLY by the
    // analyticsAggregation scheduled function via the admin SDK; readable by
    // admins only (the dashboard is admin-gated). No client writes — metrics
    // must never be forgeable.
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false; // analyticsAggregation function only via admin SDK
    }

    // ── Community Forum (Phase 4 — Workstream B) ─────────────────────────────
    // Standalone cross-cohort discussion space. Modeled on the discussions +
    // notifications blocks above.

    // forumCategories/{id}
    //   READ:  any authed user. NOTE: this was previously content-gated
    //          (visibility/cohort), but that makes a learner's *list* query
    //          (`getDocs(forumCategories)`) fail entirely — Firestore rejects a
    //          content-dependent read on a list unless the query is constrained
    //          to provably-readable docs. Since forumThreads/posts (the actual
    //          content) are already `allow read: if isAuthed()`, gating only the
    //          category metadata adds no real confidentiality. Clients keep a
    //          `visibleCategories()` filter so learners still only SEE the
    //          categories meant for them (cohort scoping is a UX concern here,
    //          not a security boundary — the thread content is open to any authed
    //          user by design).
    //   WRITE: admin-only (category management).
    match /forumCategories/{categoryId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // forumThreads/{id}
    //   READ:   any authed user (category visibility is enforced in the UI/query;
    //           thread bodies carry no cohort secrets and are deliberately
    //           cross-cohort). Admins included.
    //   CREATE: any authed user, authored as themselves, with a fixed initial
    //           shape (pinned/locked false, replyCount 0). Title/body bounded.
    //   UPDATE: author may edit ONLY title/body/editedAt; an admin may change
    //           anything (pin/lock/moderation). Reply-count/lastReplyAt bumps
    //           come from the reply write path or the admin SDK.
    //   DELETE: author or admin.
    function threadAuthorEditKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["title", "body", "editedAt"]);
    }
    match /forumThreads/{threadId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.categoryId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.pinned == false
        && request.resource.data.locked == false
        && request.resource.data.replyCount == 0;
      allow update: if isAdmin()
        || (isAuthed()
            && resource.data.authorId == request.auth.uid
            && threadAuthorEditKeys()
            && request.resource.data.title.size() >= 1
            && request.resource.data.title.size() <= 200
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 5000);
      allow delete: if isAdmin()
        || (isAuthed() && resource.data.authorId == request.auth.uid);

      // forumThreads/{id}/posts/{postId} — replies within a thread.
      //   READ:   any authed user.
      //   CREATE: any authed user, authored as themselves, ONLY when the parent
      //           thread is NOT locked — lock enforcement lives AT THE RULES
      //           LAYER (get() resolves the thread doc).
      //   UPDATE: author may edit ONLY body/editedAt; any authed user may toggle
      //           ONLY their own reaction (reactions map); admins may edit
      //           anything (moderation).
      //   DELETE: author or admin.
      match /posts/{postId} {
        function parentThread() {
          return get(/databases/$(database)/documents/forumThreads/$(threadId)).data;
        }
        function postAuthorEditKeys() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["body", "editedAt"]);
        }
        function reactionOnlyChange() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["reactions"]);
        }
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 5000
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 100
          && (request.resource.data.parentId == null
              || request.resource.data.parentId is string)
          && parentThread().locked == false;
        allow update: if isAdmin()
          || (isAuthed()
              && resource.data.authorId == request.auth.uid
              && postAuthorEditKeys()
              && request.resource.data.body.size() >= 1
              && request.resource.data.body.size() <= 5000)
          || (isAuthed() && reactionOnlyChange());
        allow delete: if isAdmin()
          || (isAuthed() && resource.data.authorId == request.auth.uid);
      }
    }

    // forumReports/{id} — user reports for moderator review.
    //   CREATE: any authed user, attributed to themselves, unresolved.
    //   READ:   admins (the moderation queue) or the reporter (their own).
    //   UPDATE: admins only (mark resolved). No deletes.
    match /forumReports/{reportId} {
      allow read: if isAdmin()
        || (isAuthed() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthed()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.threadId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.resolved == false;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
