rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Andela LMS — Firebase Storage Security Rules
//
// Layout:
//   videos/{courseId}/{moduleId}/{filename}  — lesson video files
//   (future) thumbnails/{courseId}/{filename}
//
// Policy:
//   - Any authenticated user can read videos (learner watching their course)
//   - Only admins (custom claim role == "admin") can upload/delete
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    // Videos — Phase 3 hardening: NO direct client reads (admin excepted).
    // Learners obtain short-lived V4 signed URLs from the getSignedVideoUrl
    // Cloud Function, which enforces cohort/enrollment access server-side.
    // Signed URLs bypass these rules by design; removing the blanket
    // authenticated read kills the old long-lived download-token URLs.
    match /videos/{courseId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.token.role == "admin";

      // Only admins (custom claim) may upload, update, or delete videos.
      allow write: if request.auth != null
        && request.auth.token.role == "admin";
    }

    // Captions (.vtt) — authenticated read; admin write (Phase 3)
    match /captions/{courseId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.role == "admin";
    }

    // Certificate templates — admin only (Phase 3)
    match /certTemplates/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.role == "admin";
    }

    // Issued certificate PDFs — functions only (Phase 3).
    // Learners receive short-lived signed URLs; no direct client access.
    match /certificates/{allPaths=**} {
      allow read, write: if false;
    }

    // Resources (slides / doc / lab files) — authenticated read; admin write
    match /resources/{courseId}/{allPaths=**} {
      // All authenticated users can download resource files.
      allow read: if request.auth != null;

      // Only admins (custom claim) may upload, update, or delete resources.
      allow write: if request.auth != null
        && request.auth.token.role == "admin";
    }

    // Thumbnails (courses and cohorts) — authenticated read; admin write
    match /thumbnails/{allPaths=**} {
      // All authenticated users can view thumbnails.
      allow read: if request.auth != null;

      // Only admins (custom claim) may upload, update, or delete thumbnails.
      allow write: if request.auth != null
        && request.auth.token.role == "admin";
    }

    // Catch-all: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
